{
  "consumer": {
    "name": "CineFav"
  },
  "interactions": [
    {
      "description": "a movie search for Batman",
      "providerStates": [
        {
          "name": "movies matching Batman exist"
        }
      ],
      "request": {
        "matchingRules": {
          "query": {
            "query": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/search/movie",
        "query": {
          "query": [
            "Batman"
          ]
        }
      },
      "response": {
        "body": {
          "page": 1,
          "results": [
            {
              "id": 272,
              "overview": "Após treinar com...",
              "poster_path": "/path.jpg",
              "release_date": "2005-06-15",
              "title": "Batman Begins",
              "vote_average": 7.7
            }
          ],
          "total_pages": 10,
          "total_results": 200
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.page": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.results": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.results[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.results[*].overview": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.results[*].poster_path": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.results[*].release_date": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.results[*].title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.results[*].vote_average": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.total_pages": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.total_results": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          },
          "header": {},
          "status": {}
        },
        "status": 200
      }
    },
